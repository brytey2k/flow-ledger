{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": [
            "DOM",
            "ES2022"
        ],
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true
    },
    "include": [
        "src",
        "scripts",
        "remotion.config.ts"
    ]
}
