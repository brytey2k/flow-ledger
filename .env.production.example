# Production template. Copy to .env on the server, fill every <...> placeholder, then check it with
#   php artisan app:check-environment --production
# The deploy script (scripts/deploy.sh production) runs the same check and refuses to go live until it passes.
# Never copy .env.example (the local development template) to a server.

APP_NAME="Flow Ledger"
APP_ENV=production
# php artisan key:generate --show. Keep a copy in the password manager: sessions and encrypted settings cannot be read
# without it. When rotating, move the old key to APP_PREVIOUS_KEYS (comma-separated).
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# The central domain. Organisations are reached at <id>.CENTRAL_APP_URL; the landlord console and public pages at
# CENTRAL_APP_URL itself.
CENTRAL_APP_URL=<central domain, e.g. flowledger.example.com>
APP_URL="https://${CENTRAL_APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# `file` only works with a single app server; use `cache` (with a shared store) once there are several.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# The marketing page's call and WhatsApp number.
SALES_PHONE="+233 59 220 9201"

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flow_ledger
# One role serves the central database and every organisation's database. It needs LOGIN and CREATEDB (to set up new
# organisations) and should not be a superuser; app:check-environment checks both.
DB_USERNAME=<database role>
DB_PASSWORD=<database password>

DB_TENANT_HOST=127.0.0.1
DB_TENANT_PORT=5432
DB_TENANT_DATABASE=
DB_TENANT_USERNAME=<database role>
DB_TENANT_PASSWORD=<database password>

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Tenant cache isolation needs a store with tags: redis (or memcached).
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<redis password>
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=<sending address on your Mailgun domain, e.g. no-reply@mg.example.com>
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=<mailgun domain>
MAILGUN_SECRET=<mailgun api key>
MAILGUN_ENDPOINT=api.mailgun.net

# Encrypted offsite database backups, on a different provider from the server. See docs/disaster-recovery.md.
BACKUP_DISK=backups
BACKUP_DISK_KEY=<backups bucket access key>
BACKUP_DISK_SECRET=<backups bucket secret>
BACKUP_DISK_REGION=<region>
BACKUP_DISK_BUCKET=<bucket>
BACKUP_DISK_ENDPOINT=<endpoint, e.g. https://nyc3.digitaloceanspaces.com>
# Public key only. Generate the pair with: php artisan backup:generate-key (keep the private key offline)
BACKUP_ENCRYPTION_PUBLIC_KEY=<public key>
# Set these when pg_dump on the PATH is not the database server's major version.
# BACKUP_PG_DUMP_BINARY=/usr/lib/postgresql/18/bin/pg_dump
# BACKUP_PG_RESTORE_BINARY=/usr/lib/postgresql/18/bin/pg_restore

# Single sign-on through the identity provider (IAM). Optional; once SSO_CLIENT_ID is set the rest must be filled,
# all over https.
SSO_IDP_URL=<https://iam.example.com>
SSO_IDP_INTERNAL_URL=<https://iam.example.com>
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI="https://${CENTRAL_APP_URL}/auth/sso/callback"
SSO_JWKS_URI=<https://iam.example.com/.well-known/jwks.json>
SSO_PRODUCT_SLUG=flow-ledger
SSO_AUDIENCE=flow-ledger
SSO_M2M_CLIENT_ID=
SSO_M2M_CLIENT_SECRET=
SSO_M2M_SCOPE=login:verify
SSO_M2M_INVITE_SCOPE=users:invite
SSO_M2M_APPS_SCOPE=apps:read
SSO_VERIFY_SSL=true

PENNANT_DB_CONNECTION=pgsql

VITE_APP_NAME="${APP_NAME}"

# Errors, failed backups and failed backup checks are reported here.
SENTRY_LARAVEL_DSN=<sentry dsn>
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
